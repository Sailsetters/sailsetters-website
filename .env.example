# Copy to .env.local for local development.

# Postgres connection string.
# Local dev: the Docker container on port 5433 (see README).
# Production: the Neon *pooled* connection string (host contains "-pooler"),
# not the direct one — serverless exhausts an unpooled connection.
# Neon's Vercel integration injects DATABASE_URL instead; the config accepts
# either, so nothing has to be renamed there.
DATABASE_URI=postgres://sailsetters:sailsetters_dev@127.0.0.1:5433/sailsetters

# Used to sign Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Outgoing mail (applicant emails, password resets) via the Verein's IONOS
# mailbox. Leave SMTP_HOST empty locally: emails are then logged to the
# console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=contact@sailsetters.de

# Production only: two Vercel Blob stores. A store is public or private for
# its whole lifetime, so the public media (partner logos, board photos) and the
# applicants' CVs need one each. Leave both empty locally — uploads then go to
# public/media and uploads/ on disk.
BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=
