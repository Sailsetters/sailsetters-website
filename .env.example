# Copy to .env.local for local development.

# Postgres connection string.
# Local dev: the Docker container on port 5433 (see README).
# Production: the Neon *pooled* connection string from the Vercel Marketplace
# integration — not the direct one, serverless exhausts it.
DATABASE_URI=postgres://sailsetters:sailsetters_dev@127.0.0.1:5433/sailsetters

# Used to sign Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Outgoing mail (applicant emails, password resets) via the Verein's IONOS
# mailbox. Leave SMTP_HOST empty locally: emails are then logged to the
# console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=contact@sailsetters.de

# Production only: Vercel Blob for uploads (partner logos, board photos).
# Injected automatically by the Vercel Blob integration. Leave empty locally —
# uploads then go to public/media.
BLOB_READ_WRITE_TOKEN=
