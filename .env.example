# Copy to .env.local for local development.

# Postgres connection string.
# Local dev: the Docker container on port 5433 (see README).
# Production: the Supabase *pooled* connection string from the Vercel
# Marketplace integration — not the direct one, serverless exhausts it.
DATABASE_URI=postgres://sailsetters:sailsetters_dev@127.0.0.1:5433/sailsetters

# Used to sign Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
